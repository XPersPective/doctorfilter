<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ splash icon: the launcher mark itself, so the app opens with the
    icon the user just tapped. The system draws this in a 288 dp box and only
    guarantees the centre 192 dp circle, hence the inset.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/brand_mark"
    android:inset="26%" />
