<?xml version="1.0" encoding="utf-8"?>
<!--
    Strings shown by the native layer.

    These cannot come from the app's JSON localisation files: the notification
    is built by a service that may run with no Flutter engine alive at all (after
    a reboot, or once the system has killed the UI process). Android resource
    qualifiers are the only mechanism that works there, so translations of these
    few strings live in values-<lang>/strings.xml alongside this file.
-->
<resources>
    <string name="app_name">DoctorFilter</string>

    <string name="notification_channel_name">Screen filter</string>
    <string name="notification_channel_description">Shows filter status and quick controls while the filter is running.</string>

    <string name="notification_title_active">Filter on · %1$d K</string>
    <string name="notification_title_paused">Filter paused</string>
    <string name="notification_summary">Density %1$d%% · Extra dim %2$d%%</string>

    <string name="notification_action_on">Turn on</string>
    <string name="notification_action_off">Turn off</string>
    <string name="notification_action_dimmer">Dimmer</string>
    <string name="notification_action_brighter">Brighter</string>
    <string name="notification_action_next_preset">Next</string>

    <string name="notification_pro_required">Unlock in DoctorFilter Pro</string>
</resources>
