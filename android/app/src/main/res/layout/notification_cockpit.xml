<?xml version="1.0" encoding="utf-8"?>
<!--
    The expanded notification: a full control surface for the filter.

    Built with RemoteViews, which rules out RecyclerView, custom view classes and
    <include> (an included layout keeps its inner ids, so three included rows
    would all answer to the same id). Slots are therefore written out with unique
    ids: six preset chips, shown or hidden as needed, and three axis rows.

    Six chips is what fits at the narrowest supported notification width before
    the labels stop being readable.

    Colours come from system attributes so the panel follows the device's own
    notification theme instead of fighting it in dark mode.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cockpit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/cockpit_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/cockpit_power"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_power"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_on" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cockpit_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/chip_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/chip_swatch_0"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />

                <ImageView
                    android:id="@+id/chip_lock_0"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_locked"
                    android:visibility="gone"
                    android:contentDescription="@string/notification_pro_required" />
            </FrameLayout>

            <TextView
                android:id="@+id/chip_label_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textAppearance="@style/TextAppearance.Compat.Notification" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/chip_swatch_1"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />

                <ImageView
                    android:id="@+id/chip_lock_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_locked"
                    android:visibility="gone"
                    android:contentDescription="@string/notification_pro_required" />
            </FrameLayout>

            <TextView
                android:id="@+id/chip_label_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textAppearance="@style/TextAppearance.Compat.Notification" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/chip_swatch_2"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />

                <ImageView
                    android:id="@+id/chip_lock_2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_locked"
                    android:visibility="gone"
                    android:contentDescription="@string/notification_pro_required" />
            </FrameLayout>

            <TextView
                android:id="@+id/chip_label_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textAppearance="@style/TextAppearance.Compat.Notification" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/chip_swatch_3"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />

                <ImageView
                    android:id="@+id/chip_lock_3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_locked"
                    android:visibility="gone"
                    android:contentDescription="@string/notification_pro_required" />
            </FrameLayout>

            <TextView
                android:id="@+id/chip_label_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textAppearance="@style/TextAppearance.Compat.Notification" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/chip_swatch_4"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />

                <ImageView
                    android:id="@+id/chip_lock_4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_locked"
                    android:visibility="gone"
                    android:contentDescription="@string/notification_pro_required" />
            </FrameLayout>

            <TextView
                android:id="@+id/chip_label_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textAppearance="@style/TextAppearance.Compat.Notification" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/chip_swatch_5"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />

                <ImageView
                    android:id="@+id/chip_lock_5"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_locked"
                    android:visibility="gone"
                    android:contentDescription="@string/notification_pro_required" />
            </FrameLayout>

            <TextView
                android:id="@+id/chip_label_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textAppearance="@style/TextAppearance.Compat.Notification" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/axis_label_kelvin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />

        <ImageView
            android:id="@+id/axis_minus_kelvin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_minus"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_brighter" />

        <TextView
            android:id="@+id/axis_value_kelvin"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <ImageView
            android:id="@+id/axis_plus_kelvin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_plus"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_dimmer" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/axis_label_density"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />

        <ImageView
            android:id="@+id/axis_minus_density"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_minus"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_brighter" />

        <TextView
            android:id="@+id/axis_value_density"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <ImageView
            android:id="@+id/axis_plus_density"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_plus"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_dimmer" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/axis_label_dim"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />

        <ImageView
            android:id="@+id/axis_minus_dim"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_minus"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_brighter" />

        <TextView
            android:id="@+id/axis_value_dim"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <ImageView
            android:id="@+id/axis_plus_dim"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_plus"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_dimmer" />
    </LinearLayout>

    <TextView
        android:id="@+id/cockpit_pro_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="8dp"
        android:gravity="center"
        android:text="@string/notification_pro_required"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:background="?android:attr/selectableItemBackground"
        android:visibility="gone" />
</LinearLayout>
