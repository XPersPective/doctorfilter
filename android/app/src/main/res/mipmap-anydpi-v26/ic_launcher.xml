<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon. Without it Android 8+ shrinks the legacy PNG into a white
    circle, which made the mark look small next to other apps. The monochrome
    layer lets Android 13+ themed icons tint it rather than falling back.
    Regenerate the bitmaps with tool/brand/generate_icons.py.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
