# ==============================================================================
# Android Release Keystore Signing Configuration Example
#
# INSTRUCTIONS:
# 1. Generate an upload keystore:
#    keytool -genkey -v -keystore android/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias doctorfilter
# 2. Copy this file to "android/key.properties":
#    cp android/key.properties.example android/key.properties
# 3. Fill in your real keystore passwords and paths.
#
# IMPORTANT: Both "key.properties" and "*.jks" are gitignored and MUST NOT be committed to GitHub.
# ==============================================================================
storePassword=your_keystore_password_here
keyPassword=your_key_password_here
keyAlias=doctorfilter
storeFile=../upload-keystore.jks
