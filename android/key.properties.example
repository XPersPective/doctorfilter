# Example keystore configuration for release builds
# Copy this file to key.properties and fill with real credentials
storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=key.jks
# Real AdMob application ID (AdMob > App settings). Optional: without it the
# build uses Google's test ID.
admobAppId=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
