# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Safe to commit to GitHub (DO NOT put real secrets here!)
# Copy this file to .env and fill in your actual development/production credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# App Environment & General Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=DoctorFilter
API_BASE_URL=https://api.doctorfilter.com/v1

# ------------------------------------------------------------------------------
# In-App Purchases (RevenueCat / StoreKit / Google Play Billing)
#
# NOTE: In client-side Flutter apps, you only include PUBLIC SDK keys here.
# NEVER include your RevenueCat Secret API Key or Google Play Service Account
# private keys in Flutter client code or .env!
# ------------------------------------------------------------------------------
REVENUECAT_APPLE_API_KEY=appl_your_public_apple_sdk_key_here
REVENUECAT_GOOGLE_API_KEY=goog_your_public_google_sdk_key_here
REVENUECAT_ENTITLEMENT_ID=pro_features

# ------------------------------------------------------------------------------
# Google AdMob (Advertisements)
#
# Default values below are official Google sample test ad units:
# https://developers.google.com/admob/android/test-ads
# ------------------------------------------------------------------------------
# Android Test IDs:
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_ANDROID_INTERSTITIAL_UNIT_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_ANDROID_REWARDED_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# iOS Test IDs:
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-3940256099942544/2934735716
ADMOB_IOS_INTERSTITIAL_UNIT_ID=ca-app-pub-3940256099942544/4411468910
ADMOB_IOS_REWARDED_UNIT_ID=ca-app-pub-3940256099942544/1712485313

# ------------------------------------------------------------------------------
# Analytics, Crash Reporting & Monitoring (Sentry / Datadog)
# ------------------------------------------------------------------------------
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
