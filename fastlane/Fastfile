require "securerandom"
# DoctorFilter — Google Play yayın lanes
#
# Kullanım:
#   fastlane build_release      → AAB üretir (imzalı sürüm)
#   fastlane deploy_internal    → AAB'yi İç test (internal) kanalına yükler
#   fastlane deploy_production  → İç testteki pubspec sürümünü Üretime taşır + mağaza içeriğini günceller
#   fastlane push_metadata      → yalnızca mağaza metinlerini günceller
#
# Sürüm numarası pubspec.yaml'dan gelir (version: 2.0.0+5000; 1.x split APKs used 1002/2002/4002, so codes must stay above 4002); her yüklemede
# versionCode artırılmalı (ORTAK_UYGULAMA_STANDARDI.md 7).

default_platform(:android)

AAB_PATH = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
VERSION_CODE = File.read(File.expand_path("../pubspec.yaml", __dir__))[/^version: .*\+(\d+)/, 1].to_i

# Yayın kökü (Git dışında): D:\AppPublishing — protokol: D:\AppPublishing\README.md.
# Başka makinede APP_PUBLISHING_ROOT ile değiştirilir. İmza, kimlikler ve mağaza
# içeriği yalnızca orada durur; kaynak projede anahtar tutulmaz.
PUBLISHING_ROOT = ENV.fetch("APP_PUBLISHING_ROOT", "D:/AppPublishing")
APP_DIR = File.join(PUBLISHING_ROOT, "apps/doctorfilter")
METADATA_PATH = File.join(APP_DIR, "stores/google-play/metadata")
APP_IDS = File.join(APP_DIR, "app-ids.env")
SIGNING = File.join(APP_DIR, "credentials/android/key.properties")

# app-ids.env anahtarı → Dart --dart-define adı (lib/core/config/env_config.dart)
AD_UNITS = {
  "ADMOB_BANNER_ANDROID" => "ADMOB_ANDROID_BANNER_UNIT_ID",
  "ADMOB_INTERSTITIAL_ANDROID" => "ADMOB_ANDROID_INTERSTITIAL_UNIT_ID",
  "ADMOB_REWARDED_ANDROID" => "ADMOB_ANDROID_REWARDED_UNIT_ID",
  "ADMOB_APP_OPEN_ANDROID" => "ADMOB_ANDROID_APP_OPEN_UNIT_ID",
}

def app_ids
  UI.user_error!("Yayın kimlikleri yok: #{APP_IDS}") unless File.exist?(APP_IDS)
  File.readlines(APP_IDS, chomp: true).grep(/^[A-Z_]+=/).to_h { |l| l.split("=", 2) }
end

platform :android do
  desc "İmzalı sürüm AAB'sini üretir (yayın klasöründeki imza ve gerçek AdMob kimlikleriyle)"
  lane :build_release do
    ids = app_ids
    UI.user_error!("İmza dosyası yok: #{SIGNING}") unless File.exist?(SIGNING)
    defines = AD_UNITS.map do |key, define|
      value = ids[key].to_s
      UI.user_error!("#{APP_IDS}: #{key} eksik") unless value.start_with?("ca-app-pub-")
      UI.user_error!("#{key} Google test birimi") if value.include?("3940256099942544")
      "--dart-define=#{define}=#{value}"
    end
    app_id = ids["ADMOB_APP_ID_ANDROID"].to_s
    UI.user_error!("#{APP_IDS}: ADMOB_APP_ID_ANDROID eksik") unless app_id.include?("~")
    ENV["DOCTORFILTER_SIGNING"] = SIGNING
    ENV["ADMOB_APP_ID_ANDROID"] = app_id
    sh("flutter", "build", "appbundle", "--release", *defines, log: false)
    UI.success("AAB hazır: #{AAB_PATH}")
  end

  desc "AAB'yi Play Console İç test (internal) kanalına yükler"
  lane :deploy_internal do
    supply(
      track: "internal",
      aab: AAB_PATH,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "İç testte doğrulanmış pubspec sürümünü Üretim'e taşır ve mağaza içeriğini yükler"
  lane :deploy_production do
    supply(
      track: "internal",
      track_promote_to: "production",
      version_code: VERSION_CODE,
      metadata_path: METADATA_PATH,
    )
  end

  desc "Yalnızca mağaza metinlerini (tr-TR + en-US) Play'e gönderir"
  lane :push_metadata do
    supply(
      track: "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      metadata_path: METADATA_PATH,
    )
  end
end

IOS_METADATA_PATH = File.join(APP_DIR, "stores/app-store/metadata")
IOS_SCREENSHOTS_PATH = File.join(APP_DIR, "stores/app-store/screenshots")

platform :ios do
  desc "App Store Connect: yalnızca mağaza metinleri (App Store Connect API anahtarıyla; Mac gerekmez)"
  lane :push_metadata do
    ids = app_ids
    key = app_store_connect_api_key(
      key_id: ids.fetch("ASC_KEY_ID"),
      issuer_id: ids.fetch("ASC_ISSUER_ID"),
      key_filepath: ids.fetch("ASC_KEY_FILE"),
    )
    deliver(
      api_key: key,
      app_identifier: ids.fetch("IOS_BUNDLE_ID"),
      metadata_path: IOS_METADATA_PATH,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
    )
  end

  desc "CI (GitHub Actions macOS): dağıtım sertifikası + profil API anahtarıyla, imzalı IPA, TestFlight"
  lane :ci_release do
    kc_password = SecureRandom.hex(16)
    create_keychain(name: "ci", password: kc_password, default_keychain: true,
                    unlock: true, timeout: 3600, lock_when_sleeps: false)
    kc_path = File.expand_path("~/Library/Keychains/ci-db")
    key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILE"),
    )
    bundle = "com.crazypenguin.doctorfilter"
    team = ENV.fetch("TEAM_ID")
    cert(api_key: key, team_id: team, development: false, output_path: "build/cert",
         keychain_path: kc_path, keychain_password: kc_password)
    sigh(api_key: key, app_identifier: bundle, team_id: team, force: true, output_path: "build/profile")
    profile_name = lane_context[SharedValues::SIGH_NAME]
    export_dir = File.expand_path("build/export", __dir__)
    plist = File.expand_path("build/ExportOptions.plist", __dir__)
    FileUtils.mkdir_p(File.dirname(plist))
    File.write(plist, <<~XML)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict>
        <key>method</key><string>app-store-connect</string>
        <key>teamID</key><string>#{team}</string>
        <key>signingStyle</key><string>manual</string>
        <key>signingCertificate</key><string>Apple Distribution</string>
        <key>provisioningProfiles</key><dict><key>#{bundle}</key><string>#{profile_name}</string></dict>
        <key>uploadSymbols</key><true/>
      </dict></plist>
    XML
    sh("xcodebuild", "-exportArchive", "-archivePath", ENV.fetch("ARCHIVE"),
       "-exportOptionsPlist", plist, "-exportPath", export_dir)
    ipa = Dir[File.join(export_dir, "*.ipa")].first
    UI.user_error!("IPA üretilemedi") unless ipa
    upload_to_testflight(api_key: key, ipa: ipa, skip_waiting_for_build_processing: true)
  end

  desc "CI: simülatörden alınan ekran görüntülerini App Store Connect'e yükler"
  lane :ci_screenshots do
    key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILE"),
    )
    deliver(
      api_key: key,
      app_identifier: "com.crazypenguin.doctorfilter",
      screenshots_path: File.expand_path("../screenshots", __dir__),
      skip_metadata: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
    )
  end
end
