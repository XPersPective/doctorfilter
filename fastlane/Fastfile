# DoctorFilter — Google Play yayın lanes
#
# Kullanım:
#   fastlane build_release      → AAB üretir (imzalı sürüm)
#   fastlane deploy_internal    → AAB'yi İç test (internal) kanalına yükler
#   fastlane deploy_production  → İç testteki 2000 sürümünü Üretime taşır + mağaza içeriğini günceller
#   fastlane push_metadata      → yalnızca mağaza metinlerini (TR+EN) günceller
#
# Sürüm numarası pubspec.yaml'dan gelir (version: 2.0.0+2000); her yüklemede
# versionCode artırılmalı (ORTAK_UYGULAMA_STANDARDI.md 7).

default_platform(:android)

AAB_PATH = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
METADATA_PATH = "D:/AppPublishing/apps/doctorfilter/stores/google-play/metadata"
# Gerçek AdMob birimleri (Git dışında); yoksa derleme Google test birimlerine düşer.
DART_DEFINES = "D:/AppPublishing/apps/doctorfilter/dart-defines.env"

platform :android do
  desc "İmzalı sürüm AAB'sini üretir (flutter build appbundle --release)"
  lane :build_release do
    defines = File.exist?(DART_DEFINES) ? File.read(DART_DEFINES) : ""
    %w[BANNER INTERSTITIAL REWARDED APP_OPEN].each do |unit|
      value = defines[/^ADMOB_ANDROID_#{unit}_UNIT_ID=(\S+)/, 1]
      UI.user_error!("#{DART_DEFINES}: ADMOB_ANDROID_#{unit}_UNIT_ID eksik") if value.nil?
      UI.user_error!("ADMOB_ANDROID_#{unit}_UNIT_ID Google test birimi") if value.include?("3940256099942544")
    end
    sh("flutter", "build", "appbundle", "--release", "--dart-define-from-file=#{DART_DEFINES}")
    UI.success("AAB hazır: #{AAB_PATH}")
  end

  desc "AAB'yi Play Console İç test (internal) kanalına yükler"
  lane :deploy_internal do
    supply(
      track: "internal",
      aab: AAB_PATH,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "İç testte doğrulanmış 2000 sürümünü Üretim'e taşır ve mağaza içeriğini yükler"
  lane :deploy_production do
    supply(
      track: "internal",
      track_promote_to: "production",
      version_code: 2000,
      metadata_path: METADATA_PATH,
    )
  end

  desc "Yalnızca mağaza metinlerini (tr-TR + en-US) Play'e gönderir"
  lane :push_metadata do
    supply(
      track: "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      metadata_path: METADATA_PATH,
    )
  end
end
